#!/usr/bin/env node
/**
 * A stand-in for the Codex CLI in the relay's tests. It replays recorded
 * `codex exec --json` output from ../fixtures.
 *
 *   codex mcp list --json   prints STUB_CODEX_MCP, or a signed-in figma server
 *   codex exec ...          reads stdin, keeps it and the arguments in STUB_CODEX_LOG
 *                           as call-<n>.stdin and call-<n>.json, and prints the fixture
 *
 * STUB_CODEX_SCENARIOS is a comma list with one scenario a call. The last one repeats.
 *   success       use_figma ran and the code reported every unit written
 *   exists        use_figma ran and the code found every unit already in the file
 *   unit-failed   use_figma ran and the code reported its last unit failed
 *   tool-error    use_figma returned an error
 *   changed-code  Codex sent different code to use_figma, and Figma wrote it
 *   changed-code-failed   Codex sent different code, and use_figma returned an error
 *   wrong-file-key  Codex sent the code to another Figma file
 *   no-call       Codex replied without calling use_figma
 *   crash         Codex died before the call, with exit code 1
 *
 * For the reconcile code (a "const PAGES = " line) the result is { names }, read from
 * STUB_CODEX_NAMES (a JSON list). STUB_CODEX_RESULT_TEXT replaces the whole result text, for a
 * reply that is not what the code returns. STUB_CODEX_MESSAGE replaces the model's closing message.
 *
 * success.jsonl is the event stream of a real relay call (2026-10-18, gpt-6-luna), with
 * three placeholders: "__CODE__" (the code use_figma received), "__FILE_KEY__" and
 * "__RESULT_TEXT__" (what the code returned, as Figma's server wraps it). tool-error.jsonl
 * has the same shape with an error in place of the result. no-call.jsonl is a real call
 * (2026-10-18, gpt-5.6-terra) whose model never had use_figma. crash.jsonl follows Codex's
 * documented event shapes; no real run has produced it yet.
 */
import { mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const here = path.dirname(fileURLToPath(import.meta.url));
const args = process.argv.slice(2);

if (args[0] === "mcp" && args[1] === "list") {
  const fallback = [{ name: "figma", enabled: true, transport: { type: "streamable_http", url: "https://mcp.figma.com/mcp" }, auth_status: "o_auth" }];
  process.stdout.write(process.env.STUB_CODEX_MCP ?? JSON.stringify(fallback));
  process.exit(0);
}
if (args[0] !== "exec") {
  process.stderr.write(`stub codex: unexpected arguments ${JSON.stringify(args)}\n`);
  process.exit(2);
}

const chunks = [];
for await (const chunk of process.stdin) chunks.push(chunk);
const stdin = Buffer.concat(chunks);

const log = process.env.STUB_CODEX_LOG;
let n = 1;
if (log) {
  mkdirSync(log, { recursive: true });
  n = readdirSync(log).filter((name) => name.endsWith(".json")).length + 1;
  writeFileSync(path.join(log, `call-${n}.stdin`), stdin);
  writeFileSync(path.join(log, `call-${n}.json`), JSON.stringify({ args }));
}
// Another relay run writing to the ledger while this call runs.
if (process.env.STUB_CODEX_OTHER_RUN_LEDGER) {
  const file = process.env.STUB_CODEX_OTHER_RUN_LEDGER;
  const ledger = JSON.parse(readFileSync(file, "utf8"));
  ledger.components.Other = { "1.0.0": "sent" };
  // Marks a test wants the other run to have written, by component and version.
  for (const [name, versions] of Object.entries(JSON.parse(process.env.STUB_CODEX_OTHER_RUN_MARKS ?? "{}"))) {
    ledger.components[name] = { ...ledger.components[name], ...versions };
  }
  writeFileSync(file, JSON.stringify(ledger));
}
const scenarios = (process.env.STUB_CODEX_SCENARIOS ?? "success").split(",");
const scenario = scenarios[Math.min(n, scenarios.length) - 1];

const code = stdin.toString("utf8");
const prompt = args.at(-1);
const fileKey = /fileKey: (\S+)/.exec(prompt)?.[1] ?? "";

// What the generated code returns: one entry a unit, read from its UNITS line.
const fail = (message) => {
  process.stderr.write(`stub codex: ${message}\n`);
  process.exit(2);
};
const lines = code.split("\n");
const line = lines.find((l) => l.startsWith("const UNITS = "));
let units = [];
try {
  units = line ? JSON.parse(line.slice("const UNITS = ".length, -1)) : [];
} catch (error) {
  fail(`cannot read the UNITS line of the code: ${error.message}`);
}
// The relay encodes every string with the call's key, as the runtime would decode it in Figma.
const keyLine = lines.find((l) => l.startsWith("const KEY = "));
const key = keyLine ? JSON.parse(keyLine.slice("const KEY = ".length, -1)) : null;
const plain = (text) => {
  if (!key) return text;
  const bytes = Buffer.from(text, "base64");
  for (let i = 0; i < bytes.length; i++) bytes[i] ^= key[i % key.length];
  return bytes.toString("utf8");
};
units = units.map((unit) => ({ ...unit, id: plain(unit.id), name: unit.name === undefined ? undefined : plain(unit.name), version: unit.version === undefined ? undefined : plain(unit.version) }));
const status = scenario === "exists" ? "exists" : "written";
const results = units.map((unit) => ({ id: unit.id, status, name: `${unit.name} ${unit.version}` }));
if (scenario === "unit-failed" && results.length > 0) {
  results[results.length - 1] = { id: results.at(-1).id, status: "failed", error: "The font DM Sans Medium could not be loaded." };
}
// The reconcile code is read-only and returns the names it found.
const reconcile = lines.some((l) => l.startsWith("const PAGES = "));
let names = [];
try {
  names = JSON.parse(process.env.STUB_CODEX_NAMES ?? "[]");
} catch (error) {
  fail(`STUB_CODEX_NAMES is not JSON: ${error.message}`);
}
const returned = reconcile ? { names } : { tokens: { made: [], updated: [] }, units: results, warnings: [] };
const resultText = process.env.STUB_CODEX_RESULT_TEXT ?? JSON.stringify(returned);

const fixture = { success: "success", exists: "success", "unit-failed": "success", "changed-code": "success", "changed-code-failed": "tool-error", "wrong-file-key": "success", "tool-error": "tool-error", "no-call": "no-call", crash: "crash" }[scenario];
if (!fixture) fail(`unknown scenario ${scenario}`);
const anchor = reconcile ? "const PAGES" : "const CONFIG";
const sent = scenario.startsWith("changed-code") ? code.replace(anchor, `${anchor.slice(0, 5)} ${anchor.slice(5)}`) : code;
if (scenario.startsWith("changed-code") && sent === code) fail(`the changed-code scenario found no "${anchor}" to change in the code`);
const sentKey = scenario === "wrong-file-key" ? "SomeOtherFigmaFileKey000" : fileKey;
let template = "";
try {
  template = readFileSync(path.join(here, "..", "fixtures", `${fixture}.jsonl`), "utf8");
} catch (error) {
  fail(`cannot read the ${fixture} fixture: ${error.message}`);
}
// The model's own closing message, when a test wants it to differ from the tool's result.
const withMessage = (text) => {
  if (process.env.STUB_CODEX_MESSAGE === undefined) return text;
  return text
    .split("\n")
    .map((line) => {
      if (!line.includes('"agent_message"')) return line;
      const event = JSON.parse(line);
      event.item.text = process.env.STUB_CODEX_MESSAGE;
      return JSON.stringify(event);
    })
    .join("\n");
};
process.stdout.write(
  withMessage(template
    .replaceAll('"__CODE__"', () => JSON.stringify(sent))
    .replaceAll('"__FILE_KEY__"', () => JSON.stringify(sentKey))
    .replaceAll('"__RESULT_TEXT__"', () => JSON.stringify(resultText))),
);
if (scenario === "crash") {
  process.stderr.write("Error: stream disconnected before completion: error sending request\n");
  process.exit(1);
}
