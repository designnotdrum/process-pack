{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/docs_refresh_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
